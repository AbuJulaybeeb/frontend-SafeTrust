{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,not-found,error,loading}.tsx",
    "src/app/**/route.ts",
    "src/middleware.ts"
  ],
  "project": ["src/**/*.{js,jsx,ts,tsx}"],
  "ignore": [
    "src/components/**",
    "src/core/**",
    "src/graphql/**",
    "src/hooks/**",
    "src/interfaces/**",
    "src/layouts/**",
    "src/lib/**",
    "src/providers/**",
    "src/types/**",
    "src/utils/**",
    "src/config/**"
  ],
  "ignoreDependencies": ["tailwindcss-animate"],
  "rules": {
    "files": "off",
    "exports": "off",
    "types": "off",
    "duplicates": "off"
  }
}
